# Word-Cursor 环境变量配置
# 复制为 .env 后按需填写（.env 不会被提交到 Git）
# 在"设置"面板中修改的值也会自动回写到此文件
# 注意：公开仓库不会内嵌真实 API Key，请自行填写

# ===== LLM 主模型（由设置面板的模型选择器自动管理）=====
API_KEY=your_api_key
BASE_URL=https://api.linapi.net/v1
MODEL=gemini-3-flash-preview
TEMPERATURE=1
MAX_TOKENS=131072

# ===== PPT 图像生成（复用主模型同源 /v1/images/generations）=====
PPT_IMAGE_MODEL=gpt-image-2

# ===== 记忆系统 =====
MEMORY_ENABLED=true
MEMORY_TOP_K=5
MEMORY_MAX_CHARS=2000
MEMORY_FLUSH_THRESHOLD=12000

# ===== 本地知识库 Embedding 凭据（Base URL / Model 走本地设置）=====
EMBEDDING_API_KEY=
