# Word-Cursor 环境变量配置
# 复制为 .env 后按需填写（.env 不会被提交到 Git）
# 在"设置"面板中修改的值也会自动回写到此文件

# ===== LLM 主模型 =====
API_KEY=your_api_key
BASE_URL=https://api.linapi.net/v1
MODEL=kimi-k2.5
TEMPERATURE=1
MAX_TOKENS=4096

# ===== PPT 图像生成 =====
# 阿里云百炼 API Key（用于 PPT 图像生成）
DASHSCOPE_API_KEY=
# OpenRouter API Key（用于调用 Gemini 生成 PPT 视觉设计，可选）
OPENROUTER_API_KEY=
# 图像模型：gemini-image / z-image-turbo / qwen-image-plus
PPT_IMAGE_MODEL=gemini-image

# ===== 联网搜索 =====
# Brave Search API Key（获取：https://brave.com/search/api/）
BRAVE_API_KEY=

# ===== 本地模型（Tab 补全，可选）=====
LOCAL_MODEL_ENABLED=true
LOCAL_MODEL_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_MODEL_NAME=gpt-oss-20b
LOCAL_MODEL_API_KEY=

# ===== 记忆系统 =====
MEMORY_ENABLED=true
MEMORY_TOP_K=5
MEMORY_MAX_CHARS=2000
MEMORY_FLUSH_THRESHOLD=12000

# ===== Web 模式后备搜索（仅 Web 部署时使用，可选）=====
VITE_WEB_SEARCH_ENDPOINT=
VITE_WEB_SEARCH_KEY=